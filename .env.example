# Enterprise Trading Platform, local environment.
#
# Copy this file to .env and fill in the values marked "replace". Docker
# Compose reads .env from the repository root automatically. .env is
# git-ignored; .env.example is the template that is committed. Add your own
# variables here as you add services, so that a teammate cloning the
# repository knows what they have to set.

# --- PostgreSQL --------------------------------------------------------------

# Database name. Services in the compose stack connect to this one database.
POSTGRES_DB=trading

# Superuser created on first boot of the postgres container.
POSTGRES_USER=postgres

# Development-only password. Replace it if this stack is ever reachable from
# outside your own machine.
POSTGRES_PASSWORD=postgres_dev_password

# --- Kafka -------------------------------------------------------------------

# Bootstrap address that services inside the compose network use to reach the
# broker. Tools running on the host, outside compose, use localhost:9092
# instead. See infra/README.md.
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# --- Authentication ----------------------------------------------------------

# Shared HS256 signing secret. Whatever issues a token and whatever verifies
# one must hold the same value, which is why it lives here and not inside a
# service. Must be at least 32 characters: a short HS256 secret is
# brute-forceable offline. Replace it and never commit a real value.
JWT_SECRET=dev-only-change-me-this-secret-is-not-for-production-use

# --- Fauxnance API -----------------------------------------------------------

# Base URL of the market-data API. Fixed for the programme.
FAUXNANCE_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1

# Your personal key, sent as the X-Api-Key header. Quota is 2000 requests per
# day. Replace it with the key your instructor issued you. Never commit a real
# value and never let it reach the browser.
FAUXNANCE_API_KEY=replace-with-your-fauxnance-key
