# Enterprise Trading Platform, local environment
#
# Copy this file to .env and fill in the values marked "replace". Docker
# Compose reads .env from the repository root automatically. .env is
# git-ignored; .env.example is the template that is committed.

# --- PostgreSQL --------------------------------------------------------------

# Database name. Every service in the compose stack connects to this one
# database; the auth service uses its own schema inside it, per ARCHITECTURE.md.
POSTGRES_DB=trading

# Superuser created on first boot of the postgres container. The reference
# stack connects application services with this user directly; a real
# deployment would connect as the least-privilege trading_app role instead,
# see infra/postgres/01-schema.sql.
POSTGRES_USER=postgres

# Development-only password. Replace it if this stack is ever reachable
# outside your own machine.
POSTGRES_PASSWORD=postgres_dev_password

# --- Kafka ---------------------------------------------------------------------

# Bootstrap address services inside the compose network use to reach the
# broker. Leave this as kafka:29092 unless you have renamed the kafka
# service. Tools running on the host, outside compose, use localhost:9092
# instead: see infra/README.md.
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# --- Authentication ------------------------------------------------------------

# Shared HS256 signing secret. Both the auth service and the auth stub must
# sign with this secret, and the Trade REST API and the Portfolio and P&L
# service must verify with it, so that a token from either auth
# implementation validates everywhere without a redeploy. Replace it; never
# commit a real value. Must be at least 32 characters: the auth service
# refuses to start on a shorter one, because a short HS256 secret is
# brute-forceable offline.
JWT_SECRET=dev-only-change-me-this-secret-is-not-for-production-use

# --- Fauxnance API ---------------------------------------------------------------

# Base URL of the provided market-data API. Fixed for the programme; there
# is one instance and every participant calls the same one.
FAUXNANCE_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1

# Your personal Fauxnance key, sent as the X-Api-Key header. Quota is 2000
# requests per day per key. Replace with the key issued to you; never
# commit a real value and never let it reach the browser.
FAUXNANCE_API_KEY=replace-with-your-fauxnance-key

# --- Market-data poller ---------------------------------------------------------

# Seconds between poll cycles. Held low enough to look live in a demo, high
# enough that a handful of symbols stay well inside the daily quota.
POLL_INTERVAL_SECONDS=30
