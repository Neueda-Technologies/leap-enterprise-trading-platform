# Auth service configuration. Copy to .env for local development.
# .env is git-ignored. Never commit a real secret.

# The service listens here. The contract fixes 3000 for both implementations.
PORT=3000
NODE_ENV=development

# HS256 signing secret. Must be at least 32 characters, and must be the same
# value the Trade REST API verifies with and the same value the Sprint 6 stub
# signs with, otherwise the cutover stops being a configuration change.
JWT_SECRET=development-only-shared-secret-change-me

# Carried in the iss claim. auth-service here, auth-stub in the stub, so that a
# team can tell which implementation signed a token during the Sprint 8 cutover.
JWT_ISSUER=auth-service

# Access token 15 minutes, refresh token 7 days, per the contract.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Postgres. Either set DATABASE_URL or the discrete variables below.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/trading
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=trading
PGPOOL_MAX=10

# Apply migrations/users.sql at boot. Set to false where the infrastructure
# applies it, which is what a role without DDL rights requires.
AUTH_RUN_MIGRATIONS=true

# Seed demo1 to demo5 with the shared training password. Never true outside a
# training environment.
AUTH_SEED_DEMO_USERS=true

# Login throttling. Five attempts per minute per address.
LOGIN_THROTTLE_LIMIT=5
LOGIN_THROTTLE_TTL_SECONDS=60

# Origins allowed to call this service from a browser.
CORS_ORIGINS=http://localhost:4200
