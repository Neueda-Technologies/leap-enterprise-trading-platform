# Auth stub configuration.
# The stub holds no data, so this is the whole of it.

# The signing secret. It must match the secret the Trade REST API verifies with.
JWT_SECRET=development-only-shared-secret-change-me

# 3001 by default so that the stub and the Sprint 8 service can run at the same
# time. Set 3000 to put the stub where the contract says the auth service lives.
PORT=3001

# Carried in the iss claim. Left as auth-stub so that a token can be traced back
# to this implementation during the Sprint 8 cutover.
JWT_ISSUER=auth-stub

# Access token lifetime in seconds. Matches the real service.
ACCESS_TOKEN_TTL_SECONDS=900
