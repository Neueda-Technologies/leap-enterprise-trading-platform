# Manifest: the names the check harness needs from your design.
#
# The harness has no schema of its own and no opinion about yours. It reads
# this file to learn what you called things, then asserts behaviour against
# those names. Fill it in once your first migration exists, commit it, and
# update it if you rename something.
#
# Every CHANGE_ME below has to be replaced. scripts/check.sh stops with the
# list of the ones still outstanding.
#
# Write names exactly as they appear in the database catalogue. Postgres folds
# unquoted identifiers to lower case, so a table you created as ORDERS is
# orders here. If you cannot remember what you called something:
#
#   docker compose exec postgres psql -U postgres -d trading -c '\dt'
#   docker compose exec postgres psql -U postgres -d trading -c '\d your_table'

# The schema your tables live in. Leave this alone unless you deliberately
# created a named schema rather than using the default.
SCHEMA_NAME=public

# The one command that takes an empty database to migrated and seeded. Give it
# as a path or a command line relative to this folder, for example
# scripts/apply.sh or python3 tools/load.py. The harness runs it from this
# folder with TARGET_DATABASE set to its scratch database, and expects a
# non-zero exit if anything fails. See the sprint README.
APPLY_COMMAND=CHANGE_ME

# The table holding trading accounts.
ACCOUNTS_TABLE=CHANGE_ME

# The column on that table holding the account state.
ACCOUNTS_STATUS_COLUMN=CHANGE_ME

# The three values that column stores. These match the states named in the
# sprint brief. Change them only if your schema genuinely stores something
# else, and be ready to say why in the review.
ACCOUNTS_STATUS_ACTIVE=ACTIVE
ACCOUNTS_STATUS_SUSPENDED=SUSPENDED
ACCOUNTS_STATUS_CLOSED=CLOSED

# The table holding orders.
ORDERS_TABLE=CHANGE_ME

# The column on that table carrying the client-generated idempotency key. The
# harness asserts that a unique constraint covers it, and that the database
# refuses a second insert of the same value.
ORDERS_IDEMPOTENCY_COLUMN=CHANGE_ME
