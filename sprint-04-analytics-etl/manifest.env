# Manifest: the names the check harness needs from your pipeline.
#
# The harness has no pipeline of its own and no opinion about the names in
# yours. It reads this file to learn what you called things, then asserts
# behaviour against those names. Fill it in as the functions appear, commit
# it, and update it when you rename something.
#
# Every CHANGE_ME below has to be replaced. scripts/check.sh stops with the
# list of the ones still outstanding.

# The importable package. Leave this alone unless you renamed the package in
# pyproject.toml as well.
PACKAGE_NAME=analytics

# The three pipeline steps, written as module:function. The harness imports
# each one and asserts it is callable and that the three live in three
# different modules, which is the separation the acceptance criteria require.
# It does not call them, and it has no opinion about their arguments.
#
#   EXTRACT_CALLABLE=analytics.etl.extract:fetch_candles
#
EXTRACT_CALLABLE=CHANGE_ME
TRANSFORM_CALLABLE=CHANGE_ME
LOAD_CALLABLE=CHANGE_ME

# The test that feeds malformed input through your transform, written as a
# pytest node id relative to this folder. The harness runs exactly this test
# on its own and expects it to pass.
#
#   MALFORMED_CASE_TEST=tests/test_transform.py::test_drops_a_candle_with_no_close
#
# One node id, not a file and not a directory. Naming the test rather than
# matching on a keyword means you choose the name, and it means the harness
# reports which test it ran when it fails.
MALFORMED_CASE_TEST=CHANGE_ME
