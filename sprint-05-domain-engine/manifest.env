# Manifest: the names the check harness needs from your design.
#
# The harness has no domain model of its own and no opinion about your
# package layout. It reads this file to learn what you called things, then
# asserts behaviour against those names. Fill it in as the types appear,
# commit it, and update it when you rename something.
#
# Not everything here is yours to choose. The three enumeration names and the
# three test class names come from the acceptance criteria, so the harness
# looks for those by name and they are not in this file. Everything that is
# in this file, you named.

# The package your domain types live under. The harness accepts any package
# that starts with this, so sub-packages for models, exceptions and services
# are your decision. Change this if your team uses its own package prefix,
# and change the coordinates in pom.xml to match if you want them to agree.
BASE_PACKAGE=com.tradingplatform.domain

# The base type every domain exception extends. Give the simple class name,
# not the full package. The harness finds the compiled class under
# BASE_PACKAGE and then walks up from each of the six below until it reaches
# this one, so intermediate types of your own are allowed.
EXCEPTION_BASE=TradingException

# The six specified exception cases, one class each. The names below are the
# ones the specification uses. Change one only if you genuinely called the
# type something else, and be ready to say why in the review.
#
#   1  no account exists with the key on the request        ACC-404
EXCEPTION_ACCOUNT_NOT_FOUND=AccountNotFoundException
#   2  the account exists and is SUSPENDED or CLOSED        ACC-403
EXCEPTION_ACCOUNT_NOT_ACTIVE=AccountNotActiveException
#   3  the symbol is unknown or no longer tradable          INS-404
EXCEPTION_INSTRUMENT_NOT_FOUND=InstrumentNotFoundException
#   4  a buy costs more than the available cash balance     ORD-400
EXCEPTION_INSUFFICIENT_FUNDS=InsufficientFundsException
#   5  a sell is larger than the quantity held              ORD-409
EXCEPTION_INSUFFICIENT_HOLDINGS=InsufficientHoldingsException
#   6  the idempotency key has already been accepted        ORD-409
EXCEPTION_DUPLICATE_ORDER=DuplicateOrderException
