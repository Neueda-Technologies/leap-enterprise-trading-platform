# Manifest: the names the check harness needs from your design.
#
# The harness has no domain model of its own and no opinion about your package
# layout. It reads this file to learn what you called things, then asserts
# behaviour against those names. Fill it in as the types appear, commit it, and
# update it when you rename something.
#
# Not everything here is yours to choose. The three enumeration names and the
# three test class names come from the acceptance criteria, so the harness
# looks for those by name and they are not in this file. Everything that is in
# this file, you named.
#
# Every CHANGE_ME below has to be replaced. scripts/check.sh stops with the
# list of the ones still outstanding.

# The package your domain types live under. The harness accepts any package
# that starts with this, so sub-packages for models, exceptions and services
# are your decision. Write it as it appears in your package declaration, for
# example com.tradingplatform.domain.
BASE_PACKAGE=CHANGE_ME

# The base type every domain exception extends. Give the simple class name, not
# the full package. The harness finds the compiled class under BASE_PACKAGE and
# then walks up from each of the six below until it reaches this one, so
# intermediate types of your own are allowed.
#
#   EXCEPTION_BASE=TradingException
#
EXCEPTION_BASE=CHANGE_ME

# The six specified exception cases, one class each. The comment on each line
# is the case as the specification states it, with its catalogue code. The
# names are yours, and a name that says what the case is will not need
# explaining in the review.
#
#   1  no account exists with the key on the request        ACC-404
EXCEPTION_ACCOUNT_NOT_FOUND=CHANGE_ME
#   2  the account exists and is SUSPENDED or CLOSED        ACC-403
EXCEPTION_ACCOUNT_NOT_ACTIVE=CHANGE_ME
#   3  the symbol is unknown or no longer tradable          INS-404
EXCEPTION_INSTRUMENT_NOT_FOUND=CHANGE_ME
#   4  a buy costs more than the available cash balance     ORD-400
EXCEPTION_INSUFFICIENT_FUNDS=CHANGE_ME
#   5  a sell is larger than the quantity held              ORD-409
EXCEPTION_INSUFFICIENT_HOLDINGS=CHANGE_ME
#   6  the idempotency key has already been accepted        ORD-409
EXCEPTION_DUPLICATE_ORDER=CHANGE_ME
