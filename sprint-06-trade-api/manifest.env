# Manifest: the names the check harness needs from your design.
#
# The harness has no opinion about your package layout, your class names or
# your schema. It reads this file to learn what you called things, then asserts
# behaviour against those names. Fill it in as the service takes shape, commit
# it, and update it when you rename something.
#
# The values below are the scaffold's defaults. They are consistent with the
# package tree that ships in src/main/java and with the coordinates the
# Sprint 5 scaffold declares. Change any of them that your team decided
# differently.

# --- the service -------------------------------------------------------------

# The package your service lives under. Every class the harness looks for is
# found beneath it, so sub-packages are your decision.
BASE_PACKAGE=com.tradingplatform.tradeapi

# The port the service listens on. The contract's server list says 8080.
SERVICE_PORT=8080

# The host the harness reaches the service on in live mode. Leave it alone
# unless you publish the container port somewhere other than this machine.
SERVICE_HOST=localhost

# --- the Sprint 5 domain module ----------------------------------------------
#
# The coordinates this service resolves your domain module by. They must match
# the groupId, artifactId and version in sprint-05-domain-engine/pom.xml and
# the domain.* properties in pom.xml here. The harness resolves the artefact
# from your local Maven repository and reads its compiled classes, so
# `mvn install` in sprint-05-domain-engine has to have happened.

DOMAIN_GROUP_ID=com.tradingplatform
DOMAIN_ARTIFACT_ID=trading-engine
DOMAIN_VERSION=1.0.0

# --- the layers --------------------------------------------------------------
#
# Sub-packages of BASE_PACKAGE, without the prefix. Nest them if you like:
# `web.controller` is as valid as `web`.

# Where your controllers live. Scanned for mapper, JDBC and MyBatis imports and
# for SQL written into a string.
CONTROLLER_PACKAGE=web

# Where your MyBatis mapper interfaces live. Scanned for ${} in annotation SQL.
MAPPER_PACKAGE=repository

# Where your mapper XML lives, relative to this folder. Scanned for ${}.
# Leave it as it is if you write your statements in annotations instead; the
# harness reports an empty directory as a note rather than a failure.
MAPPER_XML_DIR=src/main/resources/mapper

# The class holding the order placement path, and the method on it that places
# an order. The harness reads the compiled class and looks for @Transactional
# on that method or on the class.
ORDER_SERVICE_CLASS=OrderService
ORDER_PLACEMENT_METHOD=placeOrder

# The account column carrying the optimistic lock version, exactly as it is
# spelled in your schema. The harness looks for it in the WHERE clause of an
# UPDATE in your mappers.
ACCOUNT_VERSION_COLUMN=version

# The Dockerfile the harness reads, relative to this folder. It must be
# multi-stage. Dockerfile.example is the naive version and is not read.
DOCKERFILE=Dockerfile

# Permitted interpolations in mapper statements, space separated, each one
# written as `path-relative-to-this-folder:name`, where name is what stands
# between the braces. The braces are left out because the shell expands them
# when it reads this file. To allow ${sortColumn} in one mapper:
#
#   MAPPER_SQL_INTERPOLATION_ALLOWLIST=src/main/resources/mapper/OrderMapper.xml:sortColumn
#
# Empty is the correct value. An entry is only defensible when the value can
# never be a bind parameter, a column name or a sort direction, and when the
# statement is reached only after the value has been checked against a fixed
# list of permitted names. Write a comment above the entry saying what does
# that checking. You will be asked about it in the review.
MAPPER_SQL_INTERPOLATION_ALLOWLIST=

# --- live mode ---------------------------------------------------------------
#
# Only read by `check.sh --live`. Live mode goes through your API and never
# looks at your schema, so these are the only names it needs. The demo users
# and the password belong to the provided auth stub and are listed in
# services/auth-stub/README.md.

# Where the auth stub answers. 3001 is the port the compose file publishes.
AUTH_HOST=localhost
AUTH_PORT=3001

# The shared password of the five demo users.
LIVE_PASSWORD='Trainee#2026'

# A demo user whose token reaches an account you seeded ACTIVE, and that
# account's numeric key. demo1 maps to account 1, demo2 to account 2, and so on.
LIVE_ACTIVE_USERNAME=demo1
LIVE_ACTIVE_ACCOUNT_ID=1

# A demo user whose token reaches an account you seeded SUSPENDED or CLOSED,
# and that account's numeric key. Change both to match your own seed data.
LIVE_INACTIVE_USERNAME=demo4
LIVE_INACTIVE_ACCOUNT_ID=4

# A symbol you seeded as tradable, and one that does not exist in your
# instruments table.
LIVE_TRADABLE_SYMBOL=AAPL
LIVE_UNKNOWN_SYMBOL=NOSUCHSYM

# An account key that does not exist. Used to probe the not-found path.
LIVE_UNKNOWN_ACCOUNT_ID=999999

# How many orders the concurrency probe places at once against the active
# account. Each one buys LIVE_PROBE_QUANTITY units at LIVE_PROBE_PRICE, so the
# whole probe costs a few pence of seeded cash.
LIVE_CONCURRENT_ORDERS=5
LIVE_PROBE_QUANTITY=1
LIVE_PROBE_PRICE=0.01
