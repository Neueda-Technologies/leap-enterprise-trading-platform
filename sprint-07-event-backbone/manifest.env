# Manifest: the names the check harness needs from your design.
#
# Sprint 7 builds four things that do not know about each other: three topics,
# a Java consumer, a Python producer and a batch pipeline. The harness has no
# opinion about how any of them is written. It reads this file to learn what
# you called things, then asserts behaviour against those names. Fill it in as
# the pieces appear, commit it, and update it when you rename something.
#
# No project skeleton ships with this sprint, so the values marked CHANGE_ME
# are yours to decide and scripts/check.sh stops with the list of the ones
# still outstanding. The values that are already filled in are fixed by
# contracts/kafka-topics.md, by the engineering contract in README.md, by the
# provided auth stub or by the compose file; change those only if your design
# deliberately differs.

# --- the Trade Executor -------------------------------------------------------

# The folder holding the executor's Maven build, relative to this one.
EXECUTOR_DIR=executor

# The package the executor lives under. Sub-packages are your decision. Write
# it as it appears in your package declaration, for example
# com.tradingplatform.executor.
EXECUTOR_BASE_PACKAGE=CHANGE_ME

# The consumer group every instance of the executor joins. `orders` is a work
# queue with exactly one logical consumer group, so this name is the one the
# harness looks for when it asks the broker who is reading the topic.
EXECUTOR_CONSUMER_GROUP=trade-executor

# --- the market-data poller ---------------------------------------------------

# The folder holding the poller, and the importable package inside it. The
# package name is the name a teammate types after import, and it matches the
# distribution you declared in your packaging metadata.
POLLER_DIR=poller
POLLER_PACKAGE_NAME=CHANGE_ME

# Seconds between polls, as your poller is configured to run. The harness uses
# it to size the window it waits for a quote in, and to print the quota
# arithmetic your interval implies. Below 15 seconds no configuration of the
# service survives even a half-day session.
POLL_INTERVAL_SECONDS=30

# --- the batch pipeline -------------------------------------------------------

# The folder holding the pipeline. The harness installs it into an empty
# environment and runs whatever tests it finds under it.
ETL_DIR=etl

# --- the code you characterise before you change it ---------------------------
#
# Both paths are relative to this folder. The harness reads the commit history
# of both, so keep them pointed at the real thing: moving the tests under a new
# path and leaving this stale is visible in the diff.

# Your Sprint 6 service. The harness reads its sources at
# ${SPRINT_SIX_DIR}/src/main/java and runs its build to execute the
# characterisation tests.
SPRINT_SIX_DIR=../sprint-06-trade-api

# The one package holding the characterisation tests you wrote around that
# service's order placement, and nothing else. Keeping them together is what
# makes the history readable, for example:
#
#   CHARACTERISATION_TEST_DIR=../sprint-06-trade-api/src/test/java/com/tradingplatform/tradeapi/characterisation
#
CHARACTERISATION_TEST_DIR=CHANGE_ME

# --- the topics ---------------------------------------------------------------
#
# Names and partition counts from contracts/kafka-topics.md. The contract fixes
# both. `trades` is tolerated as a name for the orders topic where a team has
# already built against it, which is the only reason these are here rather than
# written into the harness.

ORDERS_TOPIC=orders
ORDERS_PARTITIONS=3

TRADE_EVENTS_TOPIC=trade-events
TRADE_EVENTS_PARTITIONS=3

MARKET_DATA_TOPIC=market-data
MARKET_DATA_PARTITIONS=6

# --- how the harness reaches the broker and the database ----------------------
#
# Live mode runs the Kafka and Postgres command-line tools. It does not install
# them: it runs them inside the containers the compose file already starts, so
# nothing has to be on your PATH.
#
# Set the container names to empty strings if you run either service outside
# Docker, and the harness will use the tools on your PATH instead.

KAFKA_CONTAINER=kafka
KAFKA_BIN=/opt/kafka/bin
# The bootstrap address as seen by whatever runs the tools: inside the kafka
# container that is the internal listener, on your host it is localhost:9092.
KAFKA_BOOTSTRAP=kafka:29092

POSTGRES_CONTAINER=postgres
PG_DATABASE=trading
PG_USER=postgres

# --- live mode: the Trade REST API and the auth stub --------------------------
#
# Live mode places an order through your Sprint 6 service and reads the answers
# back through it. It never touches your schema directly except to plant the
# one row the dead-letter probe needs.

SERVICE_HOST=localhost
SERVICE_PORT=8080

AUTH_HOST=localhost
AUTH_PORT=3001

# The shared password of the five demo users, and a user whose token reaches an
# account you seeded ACTIVE. Both are as they were in Sprint 6.
LIVE_PASSWORD='Trainee#2026'
LIVE_ACTIVE_USERNAME=demo1
LIVE_ACTIVE_ACCOUNT_ID=1

# The order the probes place. The limit price has to be high enough that a live
# quote for this symbol is at or below it, so that the order fills rather than
# being rejected on price, and low enough that the account can afford the
# quantity. The duplicate-replay probe is far more informative against an order
# that filled.
LIVE_TRADABLE_SYMBOL=AAPL
LIVE_PROBE_QUANTITY=1
LIVE_PROBE_LIMIT_PRICE=5000.00

# How long the harness waits for your executor to settle an order, and for a
# replayed message to have had every chance to do damage. Raise it if your
# simulated execution latency is longer than a second or two.
EXECUTION_TIMEOUT_SECONDS=60

# --- live mode: the batch pipeline --------------------------------------------
#
# Three commands, run from this folder with `bash -c`. They are commands rather
# than paths because the analytical store is your choice: the schema runs on
# Snowflake, DuckDB or SQLite, and the harness has no business knowing which
# you picked.
#
# ETL_RUN_COMMAND performs one incremental load and exits non-zero if the load
# failed. The other two print one integer on standard output and nothing else.
#
# Worked examples against a DuckDB warehouse:
#
#   ETL_RUN_COMMAND='../.venv/bin/python -m your_etl_package'
#   ETL_FACT_COUNT_COMMAND='../.venv/bin/python -c "import duckdb;print(duckdb.connect(\"warehouse.duckdb\",read_only=True).execute(\"SELECT COUNT(*) FROM fact_trades\").fetchone()[0])"'
#   ETL_DEAD_LETTER_COUNT_COMMAND='../.venv/bin/python -c "import duckdb;print(duckdb.connect(\"warehouse.duckdb\",read_only=True).execute(\"SELECT COUNT(*) FROM etl_quarantine\").fetchone()[0])"'
#
# Against SQLite the same three are `sqlite3 warehouse.db "SELECT COUNT(*) ..."`.
# Against Snowflake they are whatever your client invocation looks like.

ETL_RUN_COMMAND=CHANGE_ME
ETL_FACT_COUNT_COMMAND=CHANGE_ME
ETL_DEAD_LETTER_COUNT_COMMAND=CHANGE_ME

# The row the dead-letter probe plants in the operational database, and the
# statement that removes it afterwards. It has to be a row your schema accepts
# and your pipeline must not: the default is an order dated far outside any
# sensible date dimension, filled but carrying no executed price.
#
# The harness replaces the token HARNESS_BAD_ROW_ID with a fresh identifier
# every run, so that a row an earlier run planted cannot be mistaken for this
# one. Keep the token wherever the row is identified.
#
# Correct the table and column names if your schema spells them differently. If
# the insert fails, the probe reports that and skips rather than pretending.
ETL_BAD_ROW_INSERT_SQL="INSERT INTO orders (id, account_id, symbol, side, quantity, price, status, idempotency_key, created_on) VALUES ('HARNESS_BAD_ROW_ID', ${LIVE_ACTIVE_ACCOUNT_ID}, '${LIVE_TRADABLE_SYMBOL}', 'BUY', 1, 1.00, 'FILLED', 'harness-HARNESS_BAD_ROW_ID', TIMESTAMP '2999-01-01 00:00:00')"
ETL_BAD_ROW_CLEANUP_SQL="DELETE FROM orders WHERE id = 'HARNESS_BAD_ROW_ID'"
