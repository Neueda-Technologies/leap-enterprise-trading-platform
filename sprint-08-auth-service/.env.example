# Auth service configuration. Copy this file to .env for local development.
#
# .env is git-ignored. .env.example is committed and carries no value that is
# secret, which is why JWT_SECRET below is empty rather than filled in with
# something that works.

# --- the process --------------------------------------------------------------

# The contract fixes 3000 for both implementations, so that the stub and this
# service are interchangeable behind the same address.
PORT=3000
NODE_ENV=development

# Browser origins allowed to call this service. The Angular dev server in
# Sprint 9 is the only one that needs it during the programme.
CORS_ORIGINS=http://localhost:4200

# --- token settings -------------------------------------------------------------

# HS256 signing secret, minimum 32 characters. Take the value from the
# repository root .env, because whatever issues a token and whatever verifies
# one have to hold the same value. Refuse to boot without it: a service that
# falls back to a default secret signs tokens anybody can forge.
JWT_SECRET=

# The iss claim. auth-service here, auth-stub in the fixture, so that decoding a
# token during the cutover says which implementation signed it.
JWT_ISSUER=auth-service

# Access token 15 minutes, refresh token 7 days, both from the contract. The
# access token cannot be withdrawn, which is why it is short.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# --- the credential store -------------------------------------------------------

# Postgres from the compose stack. Set DATABASE_URL, or the discrete variables,
# whichever your client prefers. The password comes from the root .env and is
# not written here.
# DATABASE_URL=
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=trading

# Where your users and refresh tokens live. Putting them in their own schema
# means the Trade REST API's role can be granted nothing on them, so an
# injection defect in the trading path cannot read a password hash.
AUTH_SCHEMA=auth

# --- password hashing -----------------------------------------------------------
#
# Your cost factors, named here so that they are configuration rather than a
# literal in the hashing code, and so that raising them is a redeploy rather
# than a rebuild. Fill in the values your team chose and be ready to say what
# you chose them against.

# argon2id, if that is your choice: memory in KiB, iterations, parallelism.
ARGON2_MEMORY_KIB=
ARGON2_TIME_COST=
ARGON2_PARALLELISM=

# bcrypt, if that is your choice: the cost exponent. The contract's floor is 12.
BCRYPT_COST=

# --- login throttling ------------------------------------------------------------

# Attempts per window per address on the login route. Throttling is not a
# substitute for the uniform failure response; it limits how fast an attacker
# can use the oracle you did not leave them.
LOGIN_THROTTLE_LIMIT=5
LOGIN_THROTTLE_TTL_SECONDS=60

# --- training conveniences --------------------------------------------------------

# Seed the demo users the rest of the platform logs in as. Never true outside a
# training environment: it writes accounts with a password that is written down.
AUTH_SEED_DEMO_USERS=false
