# Manifest: the names the check harness needs from your design.
#
# The harness has no opinion about your module layout, your class names, your
# test names or where you put the credential store. It reads this file to learn
# what you called things, then asserts behaviour against those names. Fill it in
# as the service takes shape, commit it, and update it when you rename
# something.
#
# The values below are the scaffold's defaults and are consistent with the
# module tree that ships in src/ and with the contract. Change any of them your
# team decided differently. A few keys are optional and documented as such: an
# empty value there turns one probe into a skip rather than a failure.

# --- the service ---------------------------------------------------------------

# The source tree the static checks read, relative to this folder.
SRC_DIR=src

# Where the running service answers in live mode. The contract fixes 3000 for
# both implementations, so that the stub and this service are interchangeable
# behind one address.
SERVICE_HOST=localhost
SERVICE_PORT=3000

# The OpenAPI document the running service serves. The first is the human page,
# the second is the JSON the harness fetches and reads.
OPENAPI_DOCS_PATH=/docs
OPENAPI_JSON_PATH=/docs/json

# --- the guard tests -------------------------------------------------------------
#
# Criterion 7 is that Jest covers the guard, including the expired-token and the
# wrong-signature paths. The harness runs your suite once, reads the names of
# the tests that ran, and looks for those two cases among the specs whose path
# matches GUARD_SPEC_PATTERN. All three values are extended regular expressions,
# matched case-insensitively, so name your tests however you like and correct
# the patterns here if the defaults do not match your names.

# Matched against the path of each spec file that ran. It covers the guard and
# the verification the guard delegates to, because a guard that hands the token
# to a token service is a defensible design and the two cases are then tested
# where the verifying happens. Narrow it if all of yours live in one file.
GUARD_SPEC_PATTERN='guard|token'

# Matched against the full name of each test in those files.
GUARD_EXPIRED_TEST_PATTERN='expired'
GUARD_SIGNATURE_TEST_PATTERN='signature|forged|tampered|wrong key'

# --- the never-logged rule ---------------------------------------------------------
#
# The harness reads SRC_DIR for a log call that names one of these fields on the
# same line, with comments ignored. It catches the direct case. The indirect
# ones, an error object serialised whole or a request body handed to a log call,
# are read by a human at the review.

# Field names that must never appear in a log call. Space separated.
CREDENTIAL_FIELD_NAMES="password passwordHash plainPassword refreshToken accessToken"

# What a log call looks like in your code. An extended regular expression,
# matched case-insensitively. Widen it if your logger is called something the
# default does not match.
LOG_CALL_PATTERN='(console|logger|log)\.(log|info|warn|error|debug|verbose|fatal|trace)[[:space:]]*\('

# --- the security review -------------------------------------------------------------

# Your filled-in review, and the template it was copied from, both relative to
# this folder. The harness fails if the two are still identical.
SECURITY_REVIEW_FILE=security-review/REVIEW.md
SECURITY_REVIEW_TEMPLATE=security-review/TEMPLATE.md

# The categories that must each carry a finding and a disposition. Space
# separated, matched against the start of a table row in your review. Add one if
# your review found something in a category the template does not list.
SECURITY_REVIEW_CATEGORIES="A01 A02 A03 A04 A05 A06 A07 A09"

# A finding of "none" needs a sentence of justification in the disposition, and
# this is how many words count as a sentence.
SECURITY_REVIEW_NONE_MIN_WORDS=8

# --- live mode: credentials the probes use ---------------------------------------------
#
# Live mode goes through your API. These are the only names it needs from your
# store, and they are the demo users the rest of the platform logs in as.

# A user your service can authenticate, that user's password, and the trading
# account the token should carry. Seed them, or register them by hand once.
DEMO_USERNAME=demo1
DEMO_PASSWORD='Trainee#2026'
DEMO_ACCOUNT_ID=1

# A username that does not exist, and a password that is not the right one. The
# uniform-failure probe logs in with each and compares the two answers.
UNKNOWN_USERNAME=no-such-user-for-the-harness
WRONG_PASSWORD=not-the-password-for-this-user

# How many login attempts the timing comparison makes on each path, and how far
# apart the two medians are allowed to be. The threshold is deliberately
# generous: a laptop under load, a container that has just been scheduled and a
# cold connection pool each move a response by tens of milliseconds. Raise it if
# your machine is noisy, and be ready to say why.
UNIFORM_TIMING_ATTEMPTS=5
UNIFORM_TIMING_THRESHOLD_MS=400

# The absolute threshold above is generous enough to be useless on fast
# hardware, where a whole argon2 verification costs less than it. The second
# test is on the shape rather than the size: one path taking this many times as
# long as the other is an early return however small both numbers are. The floor
# stops two responses of 1ms and 3ms being read as a factor of three.
UNIFORM_TIMING_RATIO=2
UNIFORM_TIMING_FLOOR_MS=5

# Login throttling and this probe collide, because the probe is a burst of
# failed logins from one address. The harness waits this many seconds before the
# probe and between each pair of attempts, so that the window your throttle
# counts over does not fill. A throttled request is refused before either path
# does any work, so if any attempt comes back 429 the harness reports that and
# measures nothing.
#
# Zero suits a service with no login throttle. Against the five attempts a
# minute that .env.example suggests, set UNIFORM_TIMING_ATTEMPTS=2 and
# THROTTLE_COOLDOWN_SECONDS=65, which costs the live run about two minutes. The
# arithmetic to keep to: twice the attempts, plus three, has to fit inside your
# window.
THROTTLE_COOLDOWN_SECONDS=0

# --- live mode: the credential store ---------------------------------------------------
#
# One probe reads a stored password hash back and checks that it is an argon2 or
# bcrypt value rather than a digest. It is optional, because the store is your
# design. Leave STORED_HASH_SQL empty and the probe skips.
#
# The harness runs psql inside the named container, so nothing has to be on your
# PATH. Set POSTGRES_CONTAINER to an empty string if you run Postgres outside
# Docker and psql is on your PATH instead.

POSTGRES_CONTAINER=postgres
PG_DATABASE=trading
PG_USER=postgres

# One statement returning one column and at most one row: the stored hash for
# DEMO_USERNAME. Correct the schema, table and column names if yours differ.
STORED_HASH_SQL="SELECT password_hash FROM auth.users WHERE username = '${DEMO_USERNAME}' LIMIT 1"

# --- live mode: the Sprint 6 service --------------------------------------------------
#
# The cutover probe asks your Trade REST API to accept a token this service
# issued. It needs that service running and configured against this one.

TRADE_API_HOST=localhost
TRADE_API_PORT=8080

# A route on it that requires a token and that DEMO_USERNAME's token may reach.
TRADE_API_PROTECTED_PATH=/api/v1/accounts/${DEMO_ACCOUNT_ID}

# The folder holding it, relative to this one. Read only to print the git diff
# command that the no-code-change criterion is reviewed with.
TRADE_API_DIR=../sprint-06-trade-api

# The configuration keys in that service that name the signing secret and the
# issuer it will accept. Printed in the review note, so that the reviewer can
# see what you changed and confirm that it was configuration. Correct them if
# yours are spelled differently.
TRADE_API_ISSUER_CONFIG_KEYS="JWT_SECRET JWT_REQUIRED_ISSUER"

# A commit, tag or branch from before the cutover, used to print the diff
# command. The end of Sprint 7 is the natural point. Optional: leave it empty
# and the harness prints the command with a placeholder in it.
CUTOVER_BASELINE_REF=

# --- live mode: the retired stub ------------------------------------------------------
#
# The stub signs with a development secret published in services/auth-stub/README.md.
# For as long as the platform trusts that secret, anyone who has read this
# repository can mint a token your consumers accept.
#
# Declare the decision your team took and the harness asserts it:
#
#   trusted   the platform still uses the shared development secret, which is
#             the configuration the contract describes and is acceptable in a
#             training stack. A stub token is expected to be accepted.
#   rejected  the secret was rotated when the stub was retired. A stub token is
#             expected to be refused.
STUB_SECRET_EXPECTATION=trusted

# Where the stub answers, if it is still running. The probe asks it for a token.
STUB_HOST=localhost
STUB_PORT=3001

# Optional. If the stub is not running, the harness can mint a token with its
# signing secret instead. The value is in services/auth-stub/README.md under
# "Running it". Copy it here if you want the probe to run without the stub, and
# leave it empty otherwise: the probe skips rather than failing.
STUB_DEV_SECRET=
