# Manifest: the names the check harness needs from your design.
#
# The harness has no opinion about your component names, your file layout or how
# you split the mapping from error codes to messages. It reads this file to learn
# what you called things, then asserts behaviour against those names. Fill it in
# as the application takes shape, commit it, and update it when you rename
# something.
#
# The values below are the scaffold's defaults. They are consistent with the
# directory tree that ships in src/, with angular.json and with the contracts.
# Change any of them your team decided differently. A few keys are documented as
# optional: an empty value there turns one probe into a named skip rather than a
# failure.

# --- the workspace -------------------------------------------------------------

# The source tree the static checks read, relative to this folder.
SRC_DIR=src

# Where `npm run build` puts the production bundle. The Angular application
# builder writes dist/<project>/browser, and the project is named in
# angular.json. Correct this if you rename the project.
DIST_DIR=dist/trading-ui/browser

# Where the Playwright specs live. Matches testDir in playwright.config.ts.
E2E_DIR=e2e

# --- the generated clients ------------------------------------------------------
#
# Criterion 4 is that the API clients are generated from the contracts rather than
# hand-written. The harness reads the generator configuration, confirms the output
# is on disk, confirms it is generated output rather than a file somebody typed,
# confirms your code imports it, and regenerates into a temporary directory to
# prove the committed client still matches the contract.

# The generator configuration, read by `npm run generate` and by the harness.
# Every path and option lives in that one file so that the harness regenerates
# with exactly the settings you generate with.
GENERATOR_CONFIG=openapitools.json

# The directory holding the generated output, relative to this folder. The
# per-contract subdirectories inside it come from GENERATOR_CONFIG.
GENERATED_CLIENT_DIR=src/app/core/api

# The header the generator writes into the files it produces. Matched case
# insensitively as an extended regular expression.
GENERATOR_MARKER='auto.generated by OpenAPI Generator'

# How an import of the generated client looks in your sources. The harness
# searches SRC_DIR outside GENERATED_CLIENT_DIR for an import specifier
# containing this string, because a generated client nothing imports is a
# directory, not a client. Correct it if you moved the output.
GENERATED_IMPORT_TOKEN='core/api'

# --- the error catalogue --------------------------------------------------------
#
# Criterion 6 is that every error code in the contracts renders as a readable
# message. The harness reads the codes out of the contracts and then reads your
# mapping for each one.

# The contracts, relative to this folder, and the files carrying an error
# catalogue. Both are read for their errorCode enumerations.
CONTRACTS_DIR=../contracts
CONTRACT_FILES="trade-api.yaml auth-api.yaml"

# Your mapping from code to message. A file or a directory: a directory is read
# recursively, so a team that splits the trade codes from the auth codes says so
# by naming the directory here.
ERROR_MAPPING_FILE=src/app/core/errors/error-catalogue.ts

# --- the interceptor ------------------------------------------------------------
#
# Criterion 2 has two halves, and the harness reads a named test for each. Every
# pattern here is an extended regular expression matched case insensitively
# against the names of the tests that ran.

# The interceptor itself.
INTERCEPTOR_FILE=src/app/core/interceptors/auth-interceptor.ts

# Matched against the path of each spec file that ran, to find the specs that
# cover the interceptor.
INTERCEPTOR_SPEC_PATTERN='interceptor'

# The attaching half. A test whose name matches the not-attaching pattern below
# is never counted here, however it is worded, so "attaches" and "does not
# attach" cannot both be satisfied by one test.
INTERCEPTOR_ATTACH_TEST_PATTERN='attach|adds the (bearer|token|header)|sets the authorization'

# The not-attaching half: a request to something that is not one of your own
# services carries no token.
INTERCEPTOR_NO_ATTACH_TEST_PATTERN='does not attach|never attaches|without a token|no token|third.party|other origin|external|fauxnance'

# --- the bundle scan ------------------------------------------------------------
#
# Criterion 8 is that the production bundle carries no key and no secret. The
# harness greps DIST_DIR for each pattern below. They are extended regular
# expressions, matched case insensitively, and each is documented in the brief.

# A market-data key, by any of the names it is usually given.
BUNDLE_API_KEY_PATTERN='x-api-key|api[_-]key|fauxnance'

# The market-data host. The Angular application never calls it, so its address
# has no reason to be in the bundle. Any execute-api host counts, so that a team
# who was given a different address is still caught.
BUNDLE_FAUXNANCE_URL_PATTERN='execute-api\.[a-z0-9-]+\.amazonaws\.com'

# A signing secret, by name or by shape: a secret assigned a long literal, and a
# three-part JWT written into the source.
BUNDLE_SECRET_PATTERN='jwt[_-]?secret|secret[^A-Za-z0-9]{0,4}["'"'"'][A-Za-z0-9_+/=-]{24,}["'"'"']|eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}'

# Optional. The repository root .env, which holds the real values of your own
# key and signing secret. When it is present the harness also searches the
# bundle for those literal values, which catches a key pasted in under a name no
# pattern above would match. The harness never prints the values it reads.
# Leave it empty and that second search is skipped.
ROOT_ENV_FILE=../.env

# --- live mode: your running stack ------------------------------------------------
#
# Live mode needs your whole stack up: this application served, the Trade REST
# API and the Auth service. Live mode starts nothing.

UI_BASE_URL=http://localhost:4200
TRADE_API_BASE_URL=http://localhost:8080
AUTH_API_BASE_URL=http://localhost:3000

# --- live mode: the three journeys ------------------------------------------------
#
# The three named journeys, relative to this folder. The harness runs each one
# separately, so that a journey which only passes after another has run is a
# failure here rather than a surprise at the review.

E2E_LOGIN_SPEC=e2e/login.spec.ts
E2E_PLACE_ORDER_SPEC=e2e/place-order.spec.ts
E2E_HISTORY_SPEC=e2e/blotter.spec.ts

# --- live mode: credentials and routes ---------------------------------------------
#
# The harness exports these to Playwright as E2E_BASE_URL, E2E_TRADE_API,
# E2E_AUTH_API, E2E_USERNAME and E2E_PASSWORD, so read them in your specs from
# the environment with these names and your suite and the harness stay on one
# set of credentials.

# A user your Auth service can authenticate, and the account that user trades.
# The Sprint 8 defaults.
DEMO_USERNAME=demo1
DEMO_PASSWORD='Trainee#2026'
DEMO_ACCOUNT_ID=1

# A tradable instrument the place-order journey can buy. Your Sprint 3 seed
# decides what exists, so set this to a symbol that is in your instruments
# table and marked tradable. An unseeded symbol comes back as INS-404.
DEMO_SYMBOL=AAPL

# Live mode signs in repeatedly: at least once in each journey, and twice in the
# probes. A login throttle on your Auth service refuses the later attempts, and
# a refused sign-in reads here as a broken journey rather than as the throttle
# doing its job. The harness waits this many seconds before each journey and
# before the probe. Zero suits a service with no throttle. Against the five
# attempts a minute that Sprint 8 suggests, 65 costs the live run four minutes.
LOGIN_THROTTLE_COOLDOWN_SECONDS=0

# A route the guard protects, and the route it sends a signed-out visitor to.
GUARDED_ROUTE=/orders
LOGIN_ROUTE=/login

# How the harness drives your sign-in form. Playwright selectors, resolved
# against the first match, so the defaults accept a data-testid, an id or a name
# attribute. Narrow them to whichever your form actually uses.
LOGIN_USERNAME_SELECTOR='[data-testid="login-username"], #username, input[name="username"]'
LOGIN_PASSWORD_SELECTOR='[data-testid="login-password"], #password, input[name="password"]'
LOGIN_SUBMIT_SELECTOR='[data-testid="login-submit"], button[type="submit"]'
