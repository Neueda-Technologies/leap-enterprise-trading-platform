# Manifest: the names the check harness needs from your design.
#
# Four services this week, and the harness knows the shape of one of them. It
# reads this file to learn where each service answers, where your two documents
# live, and how to make one observable thing happen in the integration chain,
# then asserts the few things a script can assert. Everything else is read by a
# person at the review.
#
# Fill in what you can on day one and finish it as each service comes up. The
# keys documented as optional turn a probe into a named skip when they are empty
# rather than failing the run, so a Tuesday run is honest about what does not
# exist yet.

# --- the documents ----------------------------------------------------------------
#
# The folder holding your decision log entries, the template they were copied
# from, and how many filled-in entries the harness expects. An entry counts when
# it is not the template, carries the four headings the template uses, and has no
# TODO left in it.

DECISION_LOG_DIR=decision-log
DECISION_LOG_TEMPLATE=decision-log/TEMPLATE.md

# Six is a normal week for a team building four services with an integration
# chain running through three of them. Raise it if your sprint produced more.
# Lowering it is a conversation with your instructor, not a manifest edit.
DECISION_LOG_MIN_ENTRIES=6

# One combined review across the four services, relative to this folder, and the
# template it was copied from. The Sprint 8 template is the shape to use.
# The harness fails if your review is byte for byte the template.
SECURITY_REVIEW_FILE=security-review/REVIEW.md
SECURITY_REVIEW_TEMPLATE=../sprint-08-auth-service/security-review/TEMPLATE.md

# The categories that must each carry a finding and a disposition, matched
# against the start of a table row in your review. The default is the full Top
# Ten, because four services that consume events, call each other, call a third
# party and serve a customer touch more of the list than the Auth service did. A
# category that applies to none of the four is dispositioned as out of scope with
# the reason. Do not shorten this list to make the harness quiet.
SECURITY_REVIEW_CATEGORIES="A01 A02 A03 A04 A05 A06 A07 A08 A09 A10"

# A finding of "none" needs a sentence of justification in the disposition, and
# this is how many words count as a sentence.
SECURITY_REVIEW_NONE_MIN_WORDS=8

# One review covering four services has to say something about each of them. The
# harness searches the review for each name below and reports any it cannot
# find. Rename these to whatever you called your services, and keep the names
# consistent with the folders under services/.
SECURITY_REVIEW_SERVICE_NAMES="preferences notifications watchlists portfolio"

# --- live mode: the four services --------------------------------------------------
#
# Live mode goes through HTTP and starts nothing. It needs the four services
# running, your Auth service running, and Kafka and Postgres behind them.
#
# Every service gets the same four probes: the health route answers, the
# protected route refuses a request with no token, refuses a well-formed token
# signed with a key nobody holds, and answers a real token from your Auth
# service. Give each PROTECTED_PATH a route that reads rather than writes, so
# that a live run leaves nothing behind.

SERVICE_HOST=localhost

# Customer preferences. First in the build order: the other two customer-facing
# services resolve a channel through it.
PREFERENCES_PORT=8082
PREFERENCES_HEALTH_PATH=/health
PREFERENCES_PROTECTED_PATH=/api/v1/preferences/1

# Customer notifications. Consumes trade-events, delivers on the channel
# preferences holds, and is the delivery path watchlists uses.
NOTIFICATIONS_PORT=8083
NOTIFICATIONS_HEALTH_PATH=/health
NOTIFICATIONS_PROTECTED_PATH=/api/v1/notifications

# Watchlists and price alerts. Consumes market-data and raises alerts through
# notifications.
WATCHLISTS_PORT=8084
WATCHLISTS_HEALTH_PATH=/health
WATCHLISTS_PROTECTED_PATH=/api/v1/watchlists

# Portfolio and P&L. The port and both paths below are fixed by
# contracts/portfolio-api.yaml. Change them and the generated client stops
# reaching the service.
PORTFOLIO_PORT=8081
PORTFOLIO_HEALTH_PATH=/health
PORTFOLIO_PROTECTED_PATH=/api/v1/portfolio/1

# --- live mode: the token -----------------------------------------------------------
#
# The harness does not hold your signing secret and does not want it. It signs in
# to your Auth service as the demo user once and uses the access token that comes
# back for every service, which is the point: one platform token, four services
# verifying it themselves.

AUTH_HOST=localhost
AUTH_PORT=3000
AUTH_LOGIN_PATH=/auth/login

# A user your Auth service can authenticate, and the account that user trades.
# The Sprint 8 defaults.
DEMO_USERNAME=demo1
DEMO_PASSWORD='Trainee#2026'
DEMO_ACCOUNT_ID=1

# The issuer claim your Auth service puts in a token. The harness copies it into
# the forged token, so that the only thing wrong with that token is the
# signature. If yours issues no iss claim, leave this empty and the forged token
# carries none.
TOKEN_ISSUER=auth-service

# Optional. Seconds to wait before each sign-in, for a login throttle of the kind
# Sprint 8 asked for. Live mode signs in once, so zero is right for most teams.
LOGIN_THROTTLE_COOLDOWN_SECONDS=0

# --- live mode: the preferences round trip --------------------------------------------
#
# The first integration probe. It writes a channel through your own API and reads
# it back on the route another service would call. That proves the write path and
# the read path agree. Whether the value survives a restart, and whether the
# customer's next sign-in picks it up, is demonstrated at the review.
#
# Leave PREF_WRITE_PATH empty and the whole probe becomes a named skip.

PREF_WRITE_METHOD=PUT
PREF_WRITE_PATH=/api/v1/preferences/1
PREF_WRITE_BODY='{"defaultAccountId":1,"alertChannel":"EMAIL"}'

# The route the harness reads back from. Make it the one notifications calls to
# resolve a channel, if a customer's token is entitled to reach it.
PREF_READ_PATH=/api/v1/preferences/1

# The value the read-back must contain. Set it to the channel in the body above.
PREF_EXPECT_VALUE=EMAIL

# --- live mode: the trade event that becomes a notification -------------------------------
#
# The harness has no Kafka client. It cannot publish a trade event itself, so it
# runs a command you declare, then watches your notifications service for a new
# record. Give it one command that puts exactly one ORDER_FILLED event for
# DEMO_ACCOUNT_ID onto trade-events. A console producer reading a heredoc, a
# small script in your repository, or a real order placed through the Trade REST
# API all work, and the third is the one closest to the demonstration.
#
# The command runs in a shell, from this folder, with the manifest's values in
# the environment. Leave it empty and the probe is a named skip assigned to the
# live review.
#
# An example, which will not work unchanged, because your container name, your
# topic configuration and your envelope are yours:
#
#   TRADE_EVENT_PUBLISH_CMD='printf "%s\n" "$EVENT_JSON" | docker exec -i kafka \
#     kafka-console-producer --bootstrap-server localhost:9092 --topic trade-events'
#
TRADE_EVENT_PUBLISH_CMD=

# The route that lists the demo account's notification records, and the field
# name the harness counts occurrences of in the response. It counts before the
# publish and after it, and expects the count to have grown.
NOTIFICATIONS_HISTORY_PATH=/api/v1/notifications
NOTIFICATIONS_RECORD_MARKER=notificationId

# How long to wait after publishing before reading the history back. Consumption,
# preference resolution and delivery all have to happen in this window. Raise it
# if your consumer polls on a long interval.
NOTIFICATION_SETTLE_SECONDS=15

# --- live mode: the market-data quote that becomes an alert --------------------------------
#
# The second half of the chain, and the criterion that says an alert reaches the
# customer through notifications rather than a log line. Three declarations and
# the harness can watch it happen: how to create an alert, how to publish a quote
# that crosses it, and where the alert's state is readable.
#
# Leave MARKET_DATA_PUBLISH_CMD empty and the probe is a named skip.

# Optional. An alert the harness creates before publishing, so that the run does
# not depend on one somebody made by hand an hour ago. Leave the path empty if
# your team seeds an alert another way, and the harness uses whatever is already
# there. Set the threshold and the direction so that the quote below crosses it.
WATCHLIST_ALERT_SETUP_METHOD=POST
WATCHLIST_ALERT_SETUP_PATH=
WATCHLIST_ALERT_SETUP_BODY='{"symbol":"AAPL","direction":"ABOVE","threshold":1.00}'

# One command putting exactly one market-data quote onto the topic, for the
# symbol above, at a price that crosses the threshold above. Same rules as
# TRADE_EVENT_PUBLISH_CMD: it runs in a shell, from this folder.
MARKET_DATA_PUBLISH_CMD=

# Where a customer reads the state of their alerts, and the string that appears
# in one that has fired. The harness reads this route after the publish and
# expects the marker to be present.
WATCHLIST_ALERTS_PATH=/api/v1/watchlists/alerts
WATCHLIST_TRIGGERED_MARKER=TRIGGERED

# How long to wait after publishing the quote. The consumer has to read it,
# evaluate the threshold, call notifications, and notifications has to record the
# delivery, so this is a longer window than the notification one.
ALERT_SETTLE_SECONDS=20

# --- live mode: the contract ---------------------------------------------------------
#
# Read for the portfolio service only. The routes are fixed by
# contracts/portfolio-api.yaml and the harness checks the shape of what they
# return against it. The other three services designed their own APIs, and no
# script here has been told what those look like.

CONTRACT_FILE=../contracts/portfolio-api.yaml
