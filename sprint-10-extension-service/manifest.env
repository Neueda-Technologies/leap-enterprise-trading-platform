# Manifest: the names the check harness needs from your design.
#
# This week the harness knows less about your service than in any previous
# sprint, because for five of the six extensions there is no contract telling it
# what to expect. It reads this file to learn which extension you chose, where
# your two documents live, and where your service answers, then asserts the few
# things a script can assert. Everything else is read by a person at the review.
#
# Fill it in on day one, commit it, and update it when you rename something. The
# keys documented as optional turn a probe into a named skip when they are empty
# rather than failing the run.

# --- the extension ---------------------------------------------------------------

# Which extension your team is building. One of the six identifiers, exactly as
# spelled in the catalogue table in README.md:
#
#   portfolio-pnl
#   trade-advice-signals
#   watchlists-price-alerts
#   customer-notifications
#   customer-preferences
#   automated-strategy-execution
#
# The harness reads this to decide which brief applies and, for portfolio-pnl,
# whether to check your responses against contracts/portfolio-api.yaml. Declare
# it once the choice is confirmed with your instructor.
EXTENSION=CHANGE_ME

# --- the decision log ---------------------------------------------------------------
#
# The folder holding your entries, the template they were copied from, and how
# many filled-in entries the harness expects to find. An entry counts when it is
# not the template, carries the four headings the template uses, and has no TODO
# left in it.

DECISION_LOG_DIR=decision-log
DECISION_LOG_TEMPLATE=decision-log/TEMPLATE.md

# Four is a normal week for a team building one service. Raise it if your sprint
# produced more, which several will. Lowering it is a conversation with your
# instructor, not a manifest edit.
DECISION_LOG_MIN_ENTRIES=4

# --- the security review -------------------------------------------------------------

# Your filled-in review, relative to this folder, and the template it was copied
# from. The Sprint 8 template is the shape to use; retitle your copy for your own
# service. The harness fails if your review is byte for byte the template.
SECURITY_REVIEW_FILE=security-review/REVIEW.md
SECURITY_REVIEW_TEMPLATE=../sprint-08-auth-service/security-review/TEMPLATE.md

# The categories that must each carry a finding and a disposition, matched
# against the start of a table row in your review. The default is the full Top
# Ten, because an extension that consumes events, calls a third party and serves
# a customer touches more of the list than the Auth service did. A category that
# does not apply to your service is dispositioned as out of scope with the
# reason. Do not shorten this list to make the harness quiet.
SECURITY_REVIEW_CATEGORIES="A01 A02 A03 A04 A05 A06 A07 A08 A09 A10"

# A finding of "none" needs a sentence of justification in the disposition, and
# this is how many words count as a sentence.
SECURITY_REVIEW_NONE_MIN_WORDS=8

# --- live mode: your service ------------------------------------------------------
#
# Live mode goes through HTTP and starts nothing. It needs your service running,
# your Auth service running, and whatever your extension consumes.

SERVICE_HOST=localhost

# Pick a port nothing else on the platform uses. 8080 is the Trade REST API,
# 3000 the Auth service, 4200 the Angular dev server. 8081 upwards is free, and
# contracts/portfolio-api.yaml names 8081 for the Portfolio and P&L service.
SERVICE_PORT=8081

# The liveness route. It takes no token: a health check that needs a credential
# is a health check the orchestrator cannot use.
HEALTH_PATH=/health

# One route on your service that requires a token and that DEMO_USERNAME's token
# is entitled to reach. The harness puts three requests to it: no token, a
# forged token, and a real one. Give it a route that reads rather than writes, so
# that a live run leaves nothing behind.
#
#   /api/v1/portfolio/1        Portfolio and P&L
#   /api/v1/watchlists         Watchlists and price alerts
#   /api/v1/preferences/1      Customer preferences
#
# Yours will be one of your own. Set it once the route exists.
PROTECTED_PATH=CHANGE_ME

# --- live mode: the token ------------------------------------------------------------
#
# The harness does not hold your signing secret and does not want it. It logs in
# to your Auth service as the demo user and uses the access token that comes
# back, which is the same path the Angular application takes.

AUTH_HOST=localhost
AUTH_PORT=3000
AUTH_LOGIN_PATH=/auth/login

# A user your Auth service can authenticate, and the account that user trades.
# The Sprint 8 defaults.
DEMO_USERNAME=demo1
DEMO_PASSWORD='Trainee#2026'
DEMO_ACCOUNT_ID=1

# The issuer claim your Auth service puts in a token. The harness copies it into
# the forged token, so that the only thing wrong with that token is the
# signature. If yours issues no iss claim, leave this empty and the forged token
# carries none.
TOKEN_ISSUER=auth-service

# Optional. Seconds to wait before each sign-in, for a login throttle of the kind
# Sprint 8 asked for. Live mode signs in once, so zero is right for most teams.
LOGIN_THROTTLE_COOLDOWN_SECONDS=0

# --- live mode: the contract, for one extension only -----------------------------------
#
# Read only when EXTENSION is portfolio-pnl. The two routes below are fixed by
# contracts/portfolio-api.yaml, and the harness checks the shape of what they
# return against it. Every other extension skips this section, because its API is
# the team's own design and no script has been told what it looks like.

CONTRACT_FILE=../contracts/portfolio-api.yaml
