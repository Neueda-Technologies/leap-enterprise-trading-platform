# Manifest: the names the check harness needs from your deployment.
#
# The harness has no AWS credentials and is never given any. Everything it knows
# about your deployment, it learns from this file and then confirms from the
# outside, over the public internet, the same way a customer would. That is a
# deliberate limit: a check that authenticated into your account could tell you
# far more, and it would also be a check that needed a key.
#
# Fill in the four values at the top once the infrastructure exists. Everything
# else ships with a defensible default. The keys documented as optional turn a
# probe into a named skip when they are empty rather than failing the run.

# --- what you deployed ---------------------------------------------------------------
#
# Read by live mode only. Static mode reports them as a skip while they are unset,
# which is the expected result until the distribution is up.

# The distribution's own domain, hostname only. No scheme, no trailing slash and
# no path: the harness puts https:// on the front itself, because criterion 1 is
# about HTTPS and a manifest that could name http:// would let that check pass
# against the wrong thing.
#
#   CLOUDFRONT_DOMAIN=d111111abcdef8.cloudfront.net
#
# A custom domain in front of the distribution is fine to declare here instead,
# if your team went that far. It is not required by the criteria.
CLOUDFRONT_DOMAIN=CHANGE_ME

# The bucket holding the build. The harness never reads from it: it addresses the
# bucket's own endpoints and expects to be refused, which is criterion 2.
#
# Name it without dots. A dot in a bucket name breaks the certificate on the
# bucket's own HTTPS endpoint, which turns the denial probe below into a skip and
# is a nuisance in several other places besides.
BUCKET_NAME=CHANGE_ME

# The region the bucket lives in. It appears in the bucket endpoints the harness
# probes, so a wrong value here produces a redirect rather than a denial, and the
# harness says so rather than passing you.
AWS_REGION=eu-west-2

# --- the deployment entry point --------------------------------------------------------
#
# Criterion 4 is one script covering build, upload and invalidation. The harness
# reads the file: it does not run it, does not deploy anything and cannot tell
# whether the file works. Presence and shape only.

# Path to your entry point, relative to this folder. A script at the repository
# root would be ../deploy/deploy-ui.sh. Declare the one you would run.
DEPLOY_ENTRYPOINT=CHANGE_ME

# Optional. Space-separated extra paths, relative to this folder, that make up the
# rest of the deployment. Set this when your entry point calls a second script:
# the three stages are then searched for across both files together, which is the
# honest way to read a two-file deployment.
#
#   DEPLOY_SUPPORTING_FILES="../deploy/build-ui.sh"
DEPLOY_SUPPORTING_FILES=""

# The three stages, as extended regular expressions matched case insensitively
# across the files above. They are loose on purpose: the harness is confirming
# that a stage is present, not dictating how you wrote it. If your deployment
# genuinely does a stage some other way, widen the pattern here and be ready to
# explain it at the review. Deleting a stage from this list does not delete it
# from the criteria.
DEPLOY_BUILD_PATTERN='ng build|npm run build|yarn build|npm ci'
DEPLOY_UPLOAD_PATTERN='s3 sync|s3 cp|s3api put-object'
DEPLOY_INVALIDATE_PATTERN='create-invalidation'

# --- the key scan --------------------------------------------------------------------
#
# Criterion 6 includes no long-lived key in the repository. The harness searches
# your working tree for the two shapes an AWS credential takes.

# The tree to search, relative to this folder. The repository root, so that a key
# committed anywhere counts, not only a key committed in this sprint's folder.
REPO_SCAN_ROOT=..

# An access key id: four fixed characters and sixteen more, uppercase. AKIA is a
# long-lived user key and ASIA a temporary session key. Matched case sensitively,
# because these identifiers are uppercase and a case-insensitive search finds
# ordinary words.
AWS_ACCESS_KEY_ID_PATTERN='(AKIA|ASIA)[0-9A-Z]{16}'

# A secret access key: forty base64 characters, in a place that names them. The
# name is part of the pattern deliberately. Forty characters of base64 on their
# own appear in lock files, in test fixtures and in half the hashes in a
# repository, and a check that cried wolf on those would be turned off by Tuesday.
AWS_SECRET_KEY_PATTERN='aws_secret_access_key[^A-Za-z0-9]{0,4}[A-Za-z0-9/+=]{40}'

# Directories the scan does not descend into: version control internals, and the
# generated trees that no human commits. Do not add a directory here to quieten a
# real hit.
SCAN_EXCLUDE_DIRS=".git node_modules dist target .angular .venv coverage build"

# --- the deployed page ----------------------------------------------------------------
#
# Read by live mode only.

# What tells your application apart from an error page. The harness fetches the
# root of your distribution and looks for one of these in the HTML. A CloudFront
# error page, an S3 error document and an empty bucket all return something; only
# one of them is your build.
INDEX_APP_MARKER_PATTERN='<app-root|ng-version|<[a-z][a-z0-9-]*-root'

# --- the deployed bundle --------------------------------------------------------------
#
# Sprint 9 checked the bundle in dist/ on your machine. Live mode runs the same
# patterns against the JavaScript your distribution actually serves, which is the
# only copy that matters now: a bundle can be clean locally and stale in the
# bucket, and the published one is the one the world has.
#
# The harness reads the script tags from your deployed index, fetches them, and
# searches the text. Patterns are extended regular expressions, matched case
# insensitively.

# How many scripts to fetch. Enough for a main bundle and its immediate chunks,
# not so many that a lazily split application turns one check into a download.
BUNDLE_FETCH_LIMIT=6

# A market-data key, by any of the names it is usually given.
BUNDLE_API_KEY_PATTERN='x-api-key|api[_-]key|fauxnance'

# The market-data host. The Angular application never calls it, so its address has
# no reason to be in the bundle. Any execute-api host counts, so that a team who
# was given a different address is still caught.
BUNDLE_FAUXNANCE_URL_PATTERN='execute-api\.[a-z0-9-]+\.amazonaws\.com'

# A signing secret, by name or by shape: a secret assigned a long literal, and a
# three-part JWT written into the source.
BUNDLE_SECRET_PATTERN='jwt[_-]?secret|secret[^A-Za-z0-9]{0,4}["'"'"'][A-Za-z0-9_+/=-]{24,}["'"'"']|eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}'
